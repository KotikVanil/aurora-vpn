{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurora VPN",
  "version": "1.2.0",
  "identifier": "com.aurora.vpnclient",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aurora VPN",
        "width": 1120,
        "height": 740,
        "minWidth": 940,
        "minHeight": 640,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "bin/sing-box.exe": "bin/sing-box.exe",
      "bin/xray.exe": "bin/xray.exe",
      "bin/rules/geoip-ru.srs": "bin/rules/geoip-ru.srs",
      "bin/rules/geosite-category-ru.srs": "bin/rules/geosite-category-ru.srs",
      "bin/rules/geosite-category-ads-all.srs": "bin/rules/geosite-category-ads-all.srs"
    }
  }
}
